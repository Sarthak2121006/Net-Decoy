{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetDecoyEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for the event (generated by backend if omitted)"
    },
    "session_id": {
      "type": "string",
      "description": "Session tracking identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of event occurrence"
    },
    "source_ip": {
      "type": "string",
      "description": "Source IP address of the interaction"
    },
    "page": {
      "type": "string",
      "enum": ["login", "admin", "backup", "database", "api", "search", "home"],
      "description": "Decoy page where the interaction occurred"
    },
    "action": {
      "type": "string",
      "description": "Specific user action (e.g. failed_login, user_enumeration, suspicious_query, file_download, endpoint_probe, traversal_search)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "authentication",
        "scanning",
        "user_enumeration",
        "file_enumeration",
        "sensitive_access",
        "sql_injection",
        "path_traversal",
        "api_probing"
      ],
      "description": "Broad category of the security event"
    },
    "payload": {
      "type": "object",
      "description": "Contextual metadata and non-sensitive payload parameters",
      "properties": {
        "pattern_detected": { "type": "boolean" },
        "username": { "type": "string" },
        "query": { "type": "string" },
        "file_name": { "type": "string" },
        "endpoint": { "type": "string" },
        "search_term": { "type": "string" },
        "attempts_count": { "type": "integer" }
      }
    }
  },
  "required": ["session_id", "page", "action", "event_type"]
}
